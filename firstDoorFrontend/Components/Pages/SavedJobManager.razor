@page "/saved/{Id:int}"

@inject HttpClient Http
@rendermode InteractiveServer
@using firstDoorFrontEnd.Models
@using System.Text.Json;
@using firstDoorFrontend.Components.Layout;

<NavBar />
    <div class="header">
        <h1>@Job?.Title</h1>
        </div>
<div class="page-layout">
    @if (Error != null)
    {
        <pre>@Error</pre>
    }
@if (Job != null) {


    <div class="saved-job-manager">
        
            <div class="job-header">
                    <div class="status">
                        Status: @CurrentStatus
                    </div><button class="buttonComp" @onclick="() => HandleStatusChange(Job!)">Toggle</button>

                <div class="employer-name">
                    @Job?.EmployerName
                </div>
                <a href="@Job?.Url" target="blank" class="btn btn-primary">Quick apply</a>
            </div>

            <div class="job-description">
                @((MarkupString)Job!.Description)
            </div>

            <div class="location"></div>
                <strong>Location: </strong>@Job?.Location
            </div>

            <div class="notes">
                @if(showNoteDeleteSuccess)
                {
                    <div class="delete-success">
                        <p>Note deleted successfully!</p>
                    </div>
                }

                @if(Job?.Notes?.Any() == true)
                {
                    <h3>Notes: </h3>
                    @foreach (var note in Job.Notes)
                    {
                        @if(deletingNoteId == note.Id)
                        {
                            <div class="delete-confirmation">
                                <p>Are you sure you want to delete this note?</p>
                                <button class="btn btn-danger" @onclick="() => ConfirmDeleteNote(note)">Yes, delete</button>
                                <button class="btn btn-secondary" @onclick="() => CancelDeleteNote()">No, cancel</button>
                            </div>
                        }

                        @if (editingNoteId == note.Id)
                        {
                            <textarea @bind="editableBody" @bind:event="oninput" class="form-control" rows="3"></textarea>

                            <div class="@(editableBody?.Length > 500 ? "text-danger" : "")">
                                Character count: @(editableBody?.Length ?? 0)/500
                            </div>

                            <button class="btn-success" disabled="@(editableBody!.Length > 500)" @onclick="() => SaveNote(note)">Save</button>
                            <button class="btn-danger" @onclick="CancelEdit">Cancel</button>
                        }
                        else
                        {
                            <p><strong>Date: </strong>@note.DateSaved.ToString()</p>
                            <p class="text-break">@note.Body</p>
                            <button class="buttonComp" @onclick="() => EnableEdit(note)">Edit Note @note.Id</button>
                            <button class="btn-danger" @onclick="() => RequestDeleteNote(note.Id)">Delete Note @note.Id</button>
                        }
                    }
                }
            </div>


        <div class="footer">
            <strong>Saved on: </strong>@Job?.TimeSaved.ToString() <br />
            <strong>Job ID: </strong>@Job?.Id <br />
            <strong>Source: </strong>@FormatUrl(Job!.Url) <br />
        </div>

        <AddNoteForm SavedJob="Job"/>

        
}
</div>

@code{
    [Parameter]
    public int Id { get; set; }

    private SavedJob? Job { get; set; }
    private string? Error;
    private bool statusError = false;
    public string CurrentStatus => Job?.Status.ToString().Replace("_", " ") ?? "Unknown";
    private int? editingNoteId;
    private string editableBody = "";

    private int? deletingNoteId;
    private bool showNoteDeleteSuccess = false;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            var response = await Http.GetAsync($"https://localhost:8443/api/FirstDoor/{Id}");

            Console.WriteLine($"Status: {response}");

            var content = await response.Content.ReadAsStringAsync();

            var json = await Http.GetStringAsync($"https://localhost:8443/api/FirstDoor/{Id}");

            Console.WriteLine(content);

            if (response.IsSuccessStatusCode)
            {
                Job = JsonSerializer.Deserialize<SavedJob>(content, new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    });
            }
        }
        catch (Exception ex)
        {
            Error = ex.ToString();
        }
    }

    private string FormatUrl(string? url)
    {
        return url switch
        {
            null => "No url provided",
            var u when u.Contains("jobviewtrack", StringComparison.OrdinalIgnoreCase) => "Career Jet",
            var u when u.Contains("www.reed.co.uk/jobs", StringComparison.OrdinalIgnoreCase) => "Reed",
            _ => "No recognised url provided"
        };
    }

    private async Task HandleStatusChange(SavedJob job)
    {
        statusError = false;

        try
        {
            var response = await Http.PatchAsync($"http://localhost:5095/api/FirstDoor/{job.Id}", null);

            response.EnsureSuccessStatusCode();

            Status newStatus = await response.Content.ReadFromJsonAsync<Status>();

            job.Status = newStatus;

            StateHasChanged();
        }
        catch (Exception)
        {
            statusError = true;
        }
    }

    private void EnableEdit(JobNote note)
    {
        editingNoteId = note.Id;
        editableBody = note.Body?.Trim() ?? "";
    }

    private void SaveNote(JobNote note)
    {
        note.Body = editableBody;

        editingNoteId = null;
    }

    private void CancelEdit()
    {
        editingNoteId = null;
    }

    private void RequestDeleteNote(int noteId)
    {
        deletingNoteId = noteId;
    }

    private void CancelDeleteNote()
    {
        deletingNoteId = null;
    }

    private async Task ConfirmDeleteNote(JobNote note)
    {
        if (Job?.Notes != null && note != null)
        {
            deletingNoteId = null;
            Job.Notes.Remove(note);
            StateHasChanged();

            await ShowDeleteSuccess();
        }
    }

    private async Task ShowDeleteSuccess()
    {
        showNoteDeleteSuccess = true;
        StateHasChanged();

        await Task.Delay(2000);

        showNoteDeleteSuccess = false;
        StateHasChanged();
    }
}