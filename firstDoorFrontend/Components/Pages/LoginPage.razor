@using firstDoorFrontend.Components.Layout
@rendermode InteractiveServer
@page "/login"

<NavBar />

<div>
    <h2>Login</h2>

    <div>
        <label for="username" >Username: </label>
        <input type="text" id="username" placeholder="John Appleseed" @bind="_username" />
    </div>

    <div>
        <label for="password">Password: </label>
        <input type="text" id="password" placeholder="Password" @bind="_password" />
    </div>

    <button @onclick="HandleLogin">Log In</button>

    @if(!string.IsNullOrEmpty(_errorMessage))
    {
        <p>@_errorMessage</p>
    }
    else
    {
        <p>Attempting login...</p>
    }

</div>

@code {
    private string _username = string.Empty;
    private string _password = string.Empty;
    private string _errorMessage = string.Empty;

    private void HandleLogin()
    {
        if (string.IsNullOrEmpty(_username) || string.IsNullOrEmpty(_password))
        {
            _errorMessage = "Please enter both a username and a password";
        }
        else
        {
            _errorMessage = string.Empty;
        }
    }
}
