@using firstDoorFrontend.Components.Layout
@using Models;
@rendermode InteractiveServer
@page "/"

<NavBar/>

<div class="header">
    <h1>Step into the world of tech...</h1>
</div>

<div class="page-layout">

    <Filters />

    <JobOverview CurrentJob="SelectedJob"/>
    

    <div class="content-section">
        <SearchBar />
        
        <JobLoader OnJobSelected="HandleJobSelected"/>

    </div>
</div>

@code {
    private Job? SelectedJob { get; set; }

    private void HandleJobSelected(Job job)
    {
        SelectedJob = job;
    }
}