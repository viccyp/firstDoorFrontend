@using firstDoorFrontend.Models
@using Microsoft.AspNetCore.Components
@using System.Net.Http.Json
@inject HttpClient Http
@rendermode InteractiveServer

@if (Job != null)
{

    <div class="job-card">
        <div>
            <h3>@Job.Title</h3>
            <p>Company: @Job.EmployerName</p>
            <p>Location: @Job.Location</p>
        </div>
        <div class="buttons">
            <button class="buttonComp" @onclick="() => HandleClick(Job)">View Details</button>
            <button class="buttonComp" @onclick="SaveJob">
                @(jobSaved ? "✓" : "♥️")
            </button>
        </div>
    </div>
}

@code {
    [Parameter]
    public Job? Job { get; set; }

    [Parameter]
    public EventCallback<Job> OnViewJob { get; set; }
    private bool jobSaved = false;

    private async Task HandleClick(Job job)
    {
        await OnViewJob.InvokeAsync(job);
    }

    private async Task SaveJob()
    {
        if (Job != null)
        {
            var savedJob = new
            {
                title = Job.Title,
                employerName = Job.EmployerName,
                description = Job.Description,
                location = Job.Location,
                url = Job.Url,
                status = 0
            };

            var response = await Http.PostAsJsonAsync(
                "http://localhost:5095/api/FirstDoor/saved-jobs",
                savedJob
            );

            //can dlete or alter later (if we want a message to show up)

            if (response.IsSuccessStatusCode)
            {
                jobSaved = true;
                StateHasChanged();
                await Task.Delay(2000);
                jobSaved = false;
                StateHasChanged();
            }
            else
            {
                Console.WriteLine("Failed to save job");
            }
        }
    }
}