@using firstDoorFrontEnd.Models;
@rendermode InteractiveServer


<button @onclick="HandleClick">@CurrentStatus.ToString()</button>

@code {
    [Parameter]
    public SavedJob? Job { get; set; }

    public string CurrentStatus => Job?.Status.ToString().Replace("_", " ") ?? "Unknown";

    [Parameter] public EventCallback OnClickRequested { get; set; }

    private async Task HandleClick()
    {
        await OnClickRequested.InvokeAsync();
    }
}