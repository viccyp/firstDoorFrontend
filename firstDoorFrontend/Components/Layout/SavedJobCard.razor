@using firstDoorFrontEnd.Models
@using Microsoft.AspNetCore.Components
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

@if (Job != null) 
{
    <div class="saved-job-card">

        @if(showDeleteConfirmation)
        {
            <div class="delete-confirmation">
                <p>Are you sure you want to delete this job?</p>
                <button class="btn btn-danger" @onclick="DeleteJob">Yes, delete</button>
                <button class="btn btn-secondary" @onclick="CancelDelete">No, cancel</button>
            </div>
        }

        @if(deleteSuccess)
        {
            <div class="delete-success">
                <p>Job deleted successfully!</p>
            </div>
        }

    <div class="job-header">
        <div class="title">
                <div class="status"
                     style="background-color: @StatusColour;">
                </div>
            <h3>@Job.Title</h3>
                
            </div>
            <div class="job-meta">
                <span class="employer-name"><strong>@Job.EmployerName</strong></span>
                <span class="location"> | @Job.Location</span>
            </div>



            <a href="@Job.Url"
               target="_blank"
               class="buttonComp quick-apply-button">
                Apply on website
            </a>
            <div class="time-saved">
                Saved @Job.TimeSaved
            </div>
    </div>

    <div class="job-description">
        <strong>Description</strong><br />
        @((MarkupString)Job.Description)
        </div>

        <div class="job-actions">

            <button class="buttonComp"
                    @onclick="GoToJob">
                Manage
            </button>

            <button class="buttonComp danger"
                    @onclick="RequestDeleteJob">
                Delete
            </button>

        </div>



    </div>
}



@code {
    [Parameter]
    public SavedJob? Job { get; set; }

    [Parameter]
    public EventCallback<SavedJob> OnJobStatusChange { get; set; }

    [Parameter]
    public EventCallback<SavedJob> OnDeleteRequested { get; set; }

    private bool showDeleteConfirmation = false;
    private bool deleteSuccess = false;
    public string CurrentStatus => Job?.Status.ToString().Replace("_", " ") ?? "Unknown";
    private string StatusColour => Job?.Status switch
    {
        Status.To_Apply => "#87CEFA",      // light blue
        Status.Applied => "#90EE90",       // light green
        Status.Interviewing => "#006400",  // dark green
        Status.Rejected => "#DC143C",      // red
        _ => "#808080"                     // grey fallback - should add accepted status? or is that ridiculous?
    };

   

    private void RequestDeleteJob()
    {
        if (Job != null)
        {
            showDeleteConfirmation = true;
        }
    }

    private async Task DeleteJob()
    {
        if (Job != null)
        {
            await OnDeleteRequested.InvokeAsync(Job);
        }
    }

    private void CancelDelete()
    {
        showDeleteConfirmation = false;
    }

    private void GoToJob()
    {
        NavigationManager.NavigateTo($"/saved/{Job!.Id}");
    }
}