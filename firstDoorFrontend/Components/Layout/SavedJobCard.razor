@using firstDoorFrontEnd.Models
@using Microsoft.AspNetCore.Components
@rendermode InteractiveServer

@if (Job != null) 
{
    <div class="saved-job-card">

        @if(showDeleteConfirmation)
        {
            <div class="delete-confirmation">
                <p>Are you sure you want to delete this job?</p>
                <button class="btn btn-danger" @onclick="DeleteJob">Yes, delete</button>
                <button class="btn btn-secondary" @onclick="CancelDelete">No, cancel</button>
            </div>
        }

    <div class="job-header">
            <h3>@Job.Title</h3>
            <span>Saved: @Job.TimeSaved</span>

        <a href="@Job.Url" target="blank" class="btn btn-primary">Quick apply</a>
    </div>
    <div class="job-description">
        @((MarkupString)Job.Description)
        </div>

    <h6>@Job.EmployerName</h6>
    <p><strong>Location: </strong>@Job.Location</p>
    <ChangeStatusButton Job="Job" OnClickRequested="ForwardClick"></ChangeStatusButton>

    <button class="btn btn-danger" @onclick="RequestDeleteJob">
        ✖️
    </button>

    @if(Job.Notes.Any())
    {
        <h3>Notes: </h3>
        @foreach (var note in Job.Notes)
        {
            <p>@note</p>
        }
    }
    </div>
}



@code {
    [Parameter]
    public SavedJob? Job { get; set; }

    [Parameter]
    public EventCallback<SavedJob> OnJobStatusChange { get; set; }

    [Parameter]
    public EventCallback<SavedJob> OnDeleteRequested { get; set; }

    private bool showDeleteConfirmation = false;

    private async Task ForwardClick()
    {
        if (Job != null)
        {
            await OnJobStatusChange.InvokeAsync(Job);
        }
    }

    private async Task RequestDeleteJob()
    {
        if (Job != null)
        {
            showDeleteConfirmation = true;
        }
    }

    private async Task DeleteJob()
    {
        if (Job != null)
        {
            await OnDeleteRequested.InvokeAsync(Job);
        }
    }

    private async Task CancelDelete()
    {
        showDeleteConfirmation = false;
    }
}