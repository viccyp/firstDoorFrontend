@using firstDoorFrontEnd.Models;
@using Models;
@inject HttpClient Http
@rendermode InteractiveServer

@if (SavedJob != null)
{
    <EditForm Model="request" OnValidSubmit="HandleSave" FormName="AddJobNote">
        <DataAnnotationsValidator/>
        <ValidationSummary/>

        <div>
            <label>
                Body: 
                <InputText @bind-Value="request!.Body"/>
             </label>
        </div>

        <div>
            <button type="submit">Click to add note</button>
        </div>
    </EditForm>
}

@if(postError)
{
    <p>Failed to add note. Please try again later</p>
}
else if (!postError && isPosted)
{
    <SavedJobCard Job="SavedJob" />
}

@code {
    [Parameter]
    public SavedJob? SavedJob { get; set; }

    private bool postError = false;
    private bool isPosted = false;

    private PostNoteRequest request = new();

    protected override void OnParametersSet()
    {
        if (SavedJob != null)
        {
            request.Id = SavedJob!.Id;
        }
    }

    protected async Task HandleSave()
    {
        postError = false;
        isPosted = false;

        try
        {
            var response = await Http.PostAsJsonAsync("http://localhost:5095/api/Notes", request);

            response.EnsureSuccessStatusCode();

            postError = false;
            isPosted = true;
        }
        catch (Exception)
        {
            postError = true;
        }
    }
}