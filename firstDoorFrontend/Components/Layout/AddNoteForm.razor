@using firstDoorFrontEnd.Models;
@using Models;
@rendermode InteractiveServer

@if (SavedJob != null)
{
    <EditForm Model="postNoteRequest" OnValidSubmit="HandleSave" FormName="AddJobNote">
        <DataAnnotationsValidator/>
        <ValidationSummary/>

        <div>
            <label>
                Body: 
                <InputText @bind-Value="postNoteRequest!.Body"/>
             </label>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public SavedJob? SavedJob { get; set; }

    private PostNoteRequest? postNoteRequest = new();

    protected async Task HandleSave()
    {
        
    }
}