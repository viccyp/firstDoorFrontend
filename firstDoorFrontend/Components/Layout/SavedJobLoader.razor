@using firstDoorFrontEnd.Models
@inject HttpClient Http
@rendermode InteractiveServer

@if (isError)
{
    <p>Error loading jobs. Please try again later.</p>
}
else if (jobs == null)
{
    <p>Loading jobs...</p>
}
else if (jobs.Count == 0)
{
    <p>No jobs found.</p>
}
else
{
    @if(showDeleteSuccess)
    {
        <div class="delete-success">
            <p>Job deleted successfully!</p>
        </div>
    }
    @if (statusError)
    {
        <div class="status-error">
            <p>Error updating job status. Please try again.</p>
        </div>
    }

    <input type="text"
           class="form-control search-input"
           placeholder="Search saved jobs..."
           @bind="SearchTerm"
           @bind:event="oninput" />


    <div class="saved-job-list-container">
        @foreach (var job in FilteredJobs())
        {
            <div class="saved-job-card">
            <SavedJobCard @key="job.Id" Job="job" OnDeleteRequested="HandleDelete"></SavedJobCard>

            </div>
        }
    </div>
}



@code {
    private List<SavedJob>? jobs = null;

    private bool isError = false;
    private bool statusError = false;
    private bool showDeleteSuccess = false;
    public string SearchTerm { get; set; } = string.Empty;


    protected override async Task OnInitializedAsync()
    {
        isError = false;
        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Get, "http://localhost:5095/api/FirstDoor");
            var response = await Http.SendAsync(request);
            response.EnsureSuccessStatusCode();
            jobs = await response.Content.ReadFromJsonAsync<List<SavedJob>>();
            jobs = jobs?.OrderByDescending(j => j.TimeSaved).ToList();
        }
        catch (Exception ex)
        {
            isError = true;
            Console.WriteLine($"Error fetching jobs: {ex.Message}");
        }
    }




    private async Task HandleDelete(SavedJob job)
    {
        try
        {
            var response = await Http.DeleteAsync($"http://localhost:5095/api/FirstDoor/{job.Id}");

            response.EnsureSuccessStatusCode();

            jobs?.Remove(job);

            StateHasChanged();

            await ShowDeleteSuccess();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting job: {ex.Message}");
        }
    }

    private async Task ShowDeleteSuccess()
    {
        showDeleteSuccess = true;

        StateHasChanged();

        await Task.Delay(3000);

        showDeleteSuccess = false;

        StateHasChanged();
    }

    private IEnumerable<SavedJob> FilteredJobs()
    {
        if (jobs is null)
            return Enumerable.Empty<SavedJob>();

    return jobs.Where(a =>
    string.IsNullOrWhiteSpace(SearchTerm) ||
    (a.Title?.Contains(
        SearchTerm,
        StringComparison.OrdinalIgnoreCase) ?? false) ||
    (a.Description?.Contains(
        SearchTerm,
        StringComparison.OrdinalIgnoreCase) ?? false)
);
    }
    }