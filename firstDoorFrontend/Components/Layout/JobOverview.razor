@using Models
@inject HttpClient Http
@rendermode InteractiveServer

@if (CurrentJob == null)
{
    <div class="job-overview">
        <h2>Job Overview</h2>

        <div class="job-header">Click on a job to see more details here!</div>
    </div>
}
else
{
    <div class="job-overview @(jobSaved ? "saved-success" : "")">
        <h2>Job Overview</h2>

        <div class="job-header">
            <h3>@CurrentJob.Title</h3>
            <div class="job-actions">
            <button class="buttonComp" @onclick="SaveJob">
                    @(jobSaved ? "✓" : "♥️")
            </button>

            <a href="@CurrentJob.Url" target="blank" class="buttonComp">Quick apply</a>
            </div>
        </div>
        <div class="job-description">
            @((MarkupString)CurrentJob.Description)
        </div>

        <h6>@CurrentJob.EmployerName</h6>
        <p><strong>Location: </strong>@CurrentJob.Location</p>
    </div>
}

@code {
    [Parameter]
    public Job? CurrentJob { get; set; } 

    private bool jobSaved;

    private void OnViewJob(Job job)
    {
        CurrentJob = job;
    }

    private async Task SaveJob()
    {
        if (CurrentJob != null)
        {
            var savedJob = new
            {
                title = CurrentJob.Title,
                employerName = CurrentJob.EmployerName,
                description = CurrentJob.Description,
                location = CurrentJob.Location,
                url = CurrentJob.Url,
                status = 0
            };

            var response = await Http.PostAsJsonAsync(
                "http://localhost:5095/api/FirstDoor/saved-jobs",
                savedJob
            );

            if (response.IsSuccessStatusCode)
            {
                jobSaved = true;
                StateHasChanged();
                await Task.Delay(2000);
                jobSaved = false;
                StateHasChanged();
            }
            else
            {
                Console.WriteLine("Failed to save job");
            }
        }
    }
}